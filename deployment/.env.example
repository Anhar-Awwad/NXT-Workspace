#NextCloud Database
POSTGRES_HOST=nextcloud-db
POSTGRES_DB=nextcloud
POSTGRES_USER=ncadmin
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Port exposed on the host for the local Nextcloud postgres container
LOCAL_NC_DB_PORT=5434

# Azure Blob Storage (optional, only fill if enable_azure_blob_storage = true in terraform.tfvars)
OBJECTSTORE_AZURE_ACCOUNT=
OBJECTSTORE_AZURE_KEY=
OBJECTSTORE_AZURE_CONTAINER=

# NextCloud Admin & Domain
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 nextcloud YOUR_VM_PUBLIC_IP"

# HTTP / HTTPS Port mappings
HTTP_PORT=80
HTTPS_PORT=443

# Container Names
NC_DB_CONTAINER_NAME=nextcloud_postgres
NC_CONTAINER_NAME=nextcloud_app
NGINX_CONTAINER_NAME=nextcloud_nginx

# Agentic RAG Vector DB
DB_NAME=vector_db
DB_USER=postgres
DB_PASSWORD= 
RAG_DB_HOST_PORT=6543
RAG_DB_CONTAINER_NAME=agentic_rag_postgres

# Agentic RAG API (FastAPI + Pydantic AI)
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8058
LOG_LEVEL=INFO
RAG_API_PORT=8058
RAG_API_CONTAINER_NAME=agentic_rag_api

OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_CHOICE=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Agentic RAG UI (Streamlit)
SERVER_PORT=8501
SERVER_HOST=0.0.0.0
RAG_UI_PORT=8501
RAG_UI_CONTAINER_NAME=agentic_rag_ui

 # RAG - NEXTCLOUD INTEGRATION
# RAG reaches Nextcloud over the internal Docker network — do NOT change this URL.
NEXTCLOUD_URL=http://nextcloud
# Service account for ingestion — must match NEXTCLOUD_ADMIN_PASSWORD above.
NEXTCLOUD_SERVICE_USER=admin
NEXTCLOUD_SERVICE_PASSWORD=
# Nextcloud group folder names to scan and ingest PDFs from (comma-separated).
NEXTCLOUD_INGEST_GROUPS=Finance,Engineering
# Background polling interval in seconds. 0 = manual ingestion only.
# 300 = auto-ingest every 5 minutes when new files are uploaded.
NEXTCLOUD_POLL_INTERVAL_SECONDS=300